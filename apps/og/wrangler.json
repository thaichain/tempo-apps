{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "og",
	"main": "src/index.tsx",
	"compatibility_date": "2025-12-17",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"EXPLORER_URL": "https://exp.thaichain.org"
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"env": {
		"thaichain": {
			"name": "og-thaichain",
			"routes": [
				{
					"custom_domain": true,
					"zone_name": "thaichain.org",
					"pattern": "og.thaichain.org"
				}
			],
			"vars": {
				"EXPLORER_URL": "https://exp.thaichain.org"
			}
		}
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
